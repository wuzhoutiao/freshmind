<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:background="@drawable/bg_app"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/screen_padding"
        android:paddingTop="@dimen/header_top_padding"
        android:paddingRight="@dimen/screen_padding">

        <ImageButton
            android:id="@+id/customIngredientBackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|bottom"
            android:background="@drawable/bg_back_icon_button"
            android:contentDescription="@string/back"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            android:scaleType="center"
            android:src="@drawable/ic_back_arrow" />

        <TextView
            android:id="@+id/customIngredientTitle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_content_height"
            android:layout_gravity="bottom"
            android:fontFamily="@font/marker_felt_wide_02"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingLeft="@dimen/header_title_safe_padding"
            android:paddingRight="@dimen/header_title_safe_padding"
            android:text="@string/custom_ingredient_entry"
            android:textColor="@color/fresh_green"
            android:textSize="@dimen/title_text_size" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingLeft="15dp"
            android:paddingTop="24dp"
            android:paddingRight="@dimen/screen_padding"
            android:paddingBottom="@dimen/content_bottom_nav_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Vegetables -->
                <LinearLayout
                    android:id="@+id/categoryVegetables"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ingredient_vegetables"
                        android:scaleType="fitCenter"
                        android:contentDescription="Vegetables" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Vegetables"
                        android:textColor="@color/fresh_blue"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Fruits -->
                <LinearLayout
                    android:id="@+id/categoryFruits"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ingredient_fruits"
                        android:scaleType="fitCenter"
                        android:contentDescription="Fruits" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Fruits"
                        android:textColor="@color/fresh_blue"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Meat -->
                <LinearLayout
                    android:id="@+id/categoryMeat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ingredient_meat"
                        android:scaleType="fitCenter"
                        android:contentDescription="Meat" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Meat"
                        android:textColor="@color/fresh_blue"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Others -->
                <LinearLayout
                    android:id="@+id/categoryOthers"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Others"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ingredient_others" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Others"
                        android:textColor="@color/fresh_blue"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="22dp"
                android:layout_marginRight="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingLeft="0dp"
                android:paddingTop="22dp"
                android:paddingRight="0dp"
                android:paddingBottom="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="Name"
                android:textColor="@color/fresh_green"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/customIngredientNameInput"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_white"
                android:inputType="text"
                android:paddingLeft="12dp"
                android:textColor="@color/fresh_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/roboto_bold"
                android:text="How would you like to enter the expiry?"
                android:textColor="@color/fresh_green"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/customExpiryMethodCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_white"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingLeft="12dp"
                android:paddingTop="10dp"
                android:paddingRight="12dp"
                android:paddingBottom="12dp">

                <CheckBox
                    android:id="@+id/customKnownExpiryCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:button="@null"
                    android:fontFamily="@font/roboto_bold"
                    android:text="I know the expiry date"
                    android:textColor="@color/fresh_blue"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="36dp"
                    android:layout_marginRight="4dp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="Choose this when the package says &quot;Best before&quot; or &quot;Use by&quot;."
                    android:textColor="@color/fresh_text"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginLeft="36dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/customExpiryDateInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_white"
                        android:hint="Expiry date: DD/MM/YYYY"
                        android:inputType="date"
                        android:paddingLeft="12dp"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/customExpiryDatePickerButton"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/bg_date_picker_button"
                        android:contentDescription="Choose expiry date"
                        android:padding="9dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_calendar_fresh" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/customShelfLifeMethodCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_white"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingLeft="12dp"
                android:paddingTop="10dp"
                android:paddingRight="12dp"
                android:paddingBottom="12dp">

                <CheckBox
                    android:id="@+id/customKnownShelfLifeCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:button="@null"
                    android:fontFamily="@font/roboto_bold"
                    android:text="I know the production date and shelf life"
                    android:textColor="@color/fresh_blue"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="36dp"
                    android:layout_marginRight="4dp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="Choose this when the package shows a production date and &quot;shelf life: 30 days&quot;."
                    android:textColor="@color/fresh_text"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="36dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_bold"
                        android:text="Production date"
                        android:textColor="@color/fresh_green"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="92dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:fontFamily="@font/roboto_bold"
                        android:text="Shelf Life"
                        android:textColor="@color/fresh_green"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="36dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/customPurchaseDateInput"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_white"
                            android:hint="DD/MM/YYYY"
                            android:inputType="date"
                            android:paddingLeft="12dp"
                            android:textSize="14sp" />

                        <ImageButton
                            android:id="@+id/customPurchaseDatePickerButton"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="8dp"
                            android:background="@drawable/bg_date_picker_button"
                            android:contentDescription="Choose production date"
                            android:padding="9dp"
                            android:scaleType="center"
                            android:src="@drawable/ic_calendar_fresh" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/customShelfLifeInput"
                        android:layout_width="92dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/bg_input_white"
                        android:hint="XX (days)"
                        android:inputType="number"
                        android:paddingLeft="12dp"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/customExpiryPreviewContainer"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_expiry_result_neutral"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_bold"
                    android:text="Final expiry date"
                    android:textColor="@color/fresh_blue"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/customExpiryPreviewText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_bold"
                    android:text="Calculated after input"
                    android:textColor="@color/fresh_blue"
                    android:textSize="12sp" />
            </LinearLayout>

                <TextView
                android:id="@+id/customSaveButton"
                android:layout_width="74dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="34dp"
                android:background="@drawable/bg_button_green"
                android:fontFamily="@font/roboto_bold"
                android:gravity="center"
                android:text="@string/save"
                android:textColor="@color/white"
                android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/partial_bottom_nav" />
</LinearLayout>
