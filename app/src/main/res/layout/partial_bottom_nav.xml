<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bottom_nav_height"
    android:background="@drawable/bg_bottom_nav"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="4dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingTop="5.5dp">

    <LinearLayout
        android:id="@+id/navDashboard"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/navDashboardIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_home_active" />

        <TextView
            android:id="@+id/navDashboardText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/nav_dashboard"
            android:textColor="@color/fresh_green"
            android:textSize="10.4sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navInventory"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/navInventoryIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_inventory" />

        <TextView
            android:id="@+id/navInventoryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/nav_inventory"
            android:textColor="@color/black"
            android:textSize="10.4sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navRecipes"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/navRecipesIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_recipes" />

        <TextView
            android:id="@+id/navRecipesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/nav_recipes"
            android:textColor="@color/black"
            android:textSize="10.4sp" />
    </LinearLayout>
</LinearLayout>
