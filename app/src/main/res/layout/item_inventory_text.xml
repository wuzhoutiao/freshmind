<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_inventory_row"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:hapticFeedbackEnabled="true"
    android:minHeight="74dp"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="12dp">

    <View
        android:id="@+id/inventoryRowStatusStrip"
        android:layout_width="4dp"
        android:layout_height="46dp"
        android:background="@color/fresh_blue" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingRight="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/inventoryRowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_bold"
            android:includeFontPadding="false"
            android:text="Garlic"
            android:textColor="@color/fresh_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/inventoryRowSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/roboto_regular"
            android:includeFontPadding="false"
            android:text="Will expire in 1 day"
            android:textColor="@color/fresh_tag_blue"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/inventoryRowStatusTag"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:background="@drawable/bg_tag_blue"
        android:fontFamily="@font/roboto_bold"
        android:gravity="center"
        android:minWidth="76dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:text="1 Day Left"
        android:textColor="@color/fresh_blue"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/inventoryRowChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right_white" />
</LinearLayout>
