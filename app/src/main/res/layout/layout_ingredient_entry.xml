<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:background="@drawable/bg_app"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/screen_padding"
        android:paddingTop="@dimen/header_top_padding"
        android:paddingRight="@dimen/screen_padding">

        <ImageButton
            android:id="@+id/ingredientEntryBackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|bottom"
            android:background="@drawable/bg_back_icon_button"
            android:contentDescription="@string/back"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            android:scaleType="center"
            android:src="@drawable/ic_back_arrow" />

        <TextView
            android:id="@+id/catalogIngredientTitle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_content_height"
            android:layout_gravity="bottom"
            android:fontFamily="@font/marker_felt_wide_02"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingLeft="@dimen/header_title_safe_padding"
            android:paddingRight="@dimen/header_title_safe_padding"
            android:text="Sweet Corn"
            android:textColor="@color/fresh_green"
            android:textSize="@dimen/title_text_size" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingLeft="@dimen/screen_padding"
            android:paddingTop="24dp"
            android:paddingRight="@dimen/screen_padding"
            android:paddingBottom="@dimen/content_bottom_nav_gap">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_bold"
            android:text="How would you like to enter the expiry?"
            android:textColor="@color/fresh_green"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/catalogExpiryMethodCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_white"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="10dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp">

            <CheckBox
                android:id="@+id/catalogKnownExpiryCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:button="@null"
                android:fontFamily="@font/roboto_bold"
                android:text="I know the expiry date"
                android:textColor="@color/fresh_blue"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:layout_marginRight="4dp"
                android:fontFamily="@font/roboto_regular"
                android:text="Choose this when the package says &quot;Best before&quot; or &quot;Use by&quot;."
                android:textColor="@color/fresh_text"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginLeft="36dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/catalogExpiryDateInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_white"
                    android:hint="Expiry date: DD/MM/YYYY"
                    android:inputType="date"
                    android:paddingLeft="12dp"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/catalogExpiryDatePickerButton"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_date_picker_button"
                    android:contentDescription="Choose expiry date"
                    android:padding="9dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_calendar_fresh" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/catalogDefaultShelfLifeMethodCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_white"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="10dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp">

            <CheckBox
                android:id="@+id/catalogDefaultShelfLifeCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:button="@null"
                android:fontFamily="@font/roboto_bold"
                android:text="Use default shelf life"
                android:textColor="@color/fresh_blue"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:layout_marginRight="4dp"
                android:fontFamily="@font/roboto_regular"
                android:text="FreshMind calculates the expiry date from the stored-from date below."
                android:textColor="@color/fresh_text"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Stored from date"
                android:textColor="@color/fresh_green"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginLeft="36dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/catalogPurchaseDateInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_white"
                    android:hint="DD/MM/YYYY"
                    android:inputType="date"
                    android:paddingLeft="12dp"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/catalogPurchaseDatePickerButton"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_date_picker_button"
                    android:contentDescription="Choose stored-from date"
                    android:padding="9dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_calendar_fresh" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Shelf life (days)"
                android:textColor="@color/fresh_green"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/catalogShelfLifeInput"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginLeft="36dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_white"
                android:hint="Shelf life days"
                android:inputType="number"
                android:paddingLeft="12dp"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/catalogSaveShelfLifeDefaultCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="36dp"
                android:layout_marginTop="8dp"
                android:background="@null"
                android:button="@null"
                android:fontFamily="@font/roboto_regular"
                android:text="Save this shelf life as the database default"
                android:textColor="@color/fresh_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/catalogExpiryPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_expiry_result_neutral"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_bold"
                android:text="Final expiry date"
                android:textColor="@color/fresh_blue"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/catalogExpiryPreviewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="Calculated after input"
                android:textColor="@color/fresh_blue"
                android:textSize="12sp" />
        </LinearLayout>

            <TextView android:id="@+id/catalogSaveButton" android:layout_width="74dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:layout_marginTop="34dp" android:background="@drawable/bg_button_green" android:fontFamily="@font/roboto_bold" android:gravity="center" android:text="@string/save" android:textColor="@color/white" android:textSize="18sp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/partial_bottom_nav" />
</LinearLayout>
