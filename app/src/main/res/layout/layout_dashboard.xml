<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:background="@drawable/bg_app"
        android:fontFamily="@font/marker_felt_wide_02"
        android:gravity="center"
        android:paddingTop="@dimen/header_top_padding"
        android:text="FreshMind"
        android:textColor="@color/fresh_green"
        android:textSize="@dimen/title_text_size" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingLeft="@dimen/screen_padding"
            android:paddingTop="@dimen/space_lg"
            android:paddingRight="@dimen/screen_padding"
            android:paddingBottom="@dimen/content_bottom_nav_gap">

            <LinearLayout
                android:id="@+id/dashboardSearchBar"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_search_bar"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/dashboardRecipeSearchInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_md"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:fontFamily="@font/roboto_regular"
                    android:hint="@string/dashboard_search_hint"
                    android:textColor="@color/fresh_text"
                    android:textColorHint="#777777"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/addIngredientsButton"
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="32dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_dashboard_add_ingredient"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:clickable="true"
                android:elevation="8dp"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="10dp"
                android:paddingTop="12dp"
                android:paddingRight="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:background="@drawable/bg_dashboard_add_ingredient_inner_line"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp">

                    <FrameLayout
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_add_icon_circle">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_add"
                            android:tint="@color/fresh_green_dark" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="24dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_medium"
                            android:text="@string/add_ingredients"
                            android:textColor="@color/white"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/roboto_regular"
                            android:text="@string/add_ingredients_subtitle"
                            android:textColor="#DFFFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_card_white"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingTop="16dp"
                android:paddingRight="18dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_bold"
                        android:text="@string/expire_in_week"
                        android:textColor="@color/fresh_blue"
                        android:textSize="18sp" />
                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dashboardReminderContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_marginTop="@dimen/space_sm">

                    <TextView
                        android:id="@+id/reminderTagEgg"
                        style="@style/IngredientTagRed"
                        android:text="egg" />

                    <TextView
                        android:id="@+id/reminderTagGarlic"
                        style="@style/IngredientTagRed"
                        android:text="garlic" />

                    <TextView
                        android:id="@+id/reminderTagOnion"
                        style="@style/IngredientTagRed"
                        android:text="onion" />

                    <TextView
                        android:id="@+id/reminderTagPeach"
                        style="@style/IngredientTagBlue"
                        android:text="peach" />

                    <TextView
                        android:id="@+id/reminderTagMilk"
                        style="@style/IngredientTagBlue"
                        android:text="milk" />

                    <TextView
                        android:id="@+id/reminderTagApple"
                        style="@style/IngredientTagBlue"
                        android:text="apple" />

                    <TextView
                        android:id="@+id/reminderTagPotato"
                        style="@style/IngredientTagBlue"
                        android:text="potato" />

                    <TextView
                        android:id="@+id/reminderTagCoconutCream"
                        style="@style/IngredientTagBlue"
                        android:text="coconut cream" />

                    <androidx.constraintlayout.helper.widget.Flow
                        android:id="@+id/dashboardReminderFlow"
                        android:layout_width="0dp"
                        android:layout_marginTop="5dp"
                        android:layout_height="wrap_content"
                        app:constraint_referenced_ids="reminderTagEgg,reminderTagGarlic,reminderTagOnion,reminderTagPeach,reminderTagMilk,reminderTagApple,reminderTagPotato,reminderTagCoconutCream"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:flow_horizontalGap="8dp"
                        app:flow_horizontalAlign="start"
                        app:flow_horizontalStyle="packed"
                        app:flow_horizontalBias="0"
                        app:flow_verticalGap="10dp"
                        app:flow_wrapMode="chain" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="32dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_white"
                android:clipChildren="true"
                android:clipToPadding="false"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingLeft="10dp"
                android:paddingTop="16dp"
                android:paddingRight="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_bold"
                    android:text="@string/today_recommendations"
                    android:textColor="@color/fresh_blue"
                    android:textSize="18sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingLeft="0dp"
                    android:paddingTop="0dp"
                    android:paddingRight="24dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/dashboardRecipeContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal">
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/partial_bottom_nav" />
</LinearLayout>
