<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:background="@drawable/bg_app"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/screen_padding"
        android:paddingTop="@dimen/header_top_padding"
        android:paddingRight="@dimen/screen_padding">

        <ImageButton
            android:id="@+id/addIngredientsBackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|bottom"
            android:background="@drawable/bg_back_icon_button"
            android:contentDescription="@string/back"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            android:scaleType="center"
            android:src="@drawable/ic_back_arrow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_content_height"
            android:layout_gravity="bottom"
            android:fontFamily="@font/marker_felt_wide_02"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingLeft="@dimen/header_title_safe_padding"
            android:paddingRight="@dimen/header_title_safe_padding"
            android:text="Add ingredients"
            android:textColor="@color/fresh_green"
            android:textSize="@dimen/title_text_size" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:paddingLeft="@dimen/screen_padding"
        android:paddingTop="24dp"
        android:paddingRight="@dimen/screen_padding"
        android:paddingBottom="@dimen/content_bottom_nav_gap">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_search_bar"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp">

                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_search" />
                <EditText
                    android:id="@+id/ingredientSearchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="16dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/roboto_regular"
                    android:hint="Search ingredient"
                    android:inputType="text"
                    android:textColor="@color/fresh_text"
                    android:textColorHint="#777777"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="36dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="18dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_white"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:elevation="2dp">

            <ScrollView
                android:id="@+id/defaultIngredientsScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="false"
                android:overScrollMode="ifContentScrolls"
                android:paddingLeft="16dp"
                android:paddingTop="14dp"
                android:paddingRight="16dp"
                android:paddingBottom="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ingredientSuggestionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="134dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_manual_add_ingredient_card"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="2dp"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_manual_add_inner_border"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <FrameLayout
                    android:layout_width="82dp"
                    android:layout_height="72dp">

                    <ImageView
                        android:layout_width="82dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right|bottom"
                        android:alpha="0.96"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_manual_ingredient_search" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:lineSpacingExtra="2dp"
                        android:text="Can't find the ingredient you're looking for?"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/manualAddIngredientText"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_card_white"
                        android:clickable="true"
                        android:drawableRight="@drawable/ic_chevron_right_white"
                        android:drawablePadding="2dp"
                        android:elevation="2dp"
                        android:focusable="true"
                        android:fontFamily="@font/roboto_bold"
                        android:gravity="center"
                        android:minWidth="140dp"
                        android:paddingLeft="15dp"
                        android:paddingRight="7dp"
                        android:text="Add it manually"
                        android:textColor="@color/fresh_green_dark"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ingredientSearchDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:background="@drawable/bg_card_white"
            android:elevation="12dp"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:translationZ="12dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/ingredientSearchResultsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </FrameLayout>

    <include layout="@layout/partial_bottom_nav" />
</LinearLayout>
