<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="196dp"
    android:layout_height="200dp"
    android:layout_marginRight="2dp"
    android:background="@drawable/bg_card_white"
    android:elevation="4dp"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/recipeCardImage"
        android:layout_width="match_parent"
        android:layout_height="135dp"
        android:background="@drawable/bg_recipe_image_placeholder"
        android:clipToOutline="true"
        android:scaleType="centerCrop" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/roboto_medium"
        android:text="Garlic Onion Scrambled Eggs"
        android:textColor="@color/fresh_text"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:fontFamily="@font/roboto_regular"
        android:text="eggs, onion, garlic, cooking oil, salt, black pepper"
        android:textColor="@color/fresh_text"
        android:textSize="9sp"
        android:textStyle="italic" />
</LinearLayout>
