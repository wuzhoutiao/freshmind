<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height"
            android:background="@drawable/bg_app"
            android:fontFamily="@font/marker_felt_wide_02"
            android:gravity="center"
            android:paddingTop="@dimen/header_top_padding"
            android:text="@string/inventory_management"
            android:textColor="@color/fresh_green"
            android:textSize="@dimen/title_text_size" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="false">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="true"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/screen_padding"
                    android:paddingTop="22dp"
                    android:paddingRight="@dimen/screen_padding"
                    android:paddingBottom="@dimen/content_bottom_nav_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_white"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:paddingLeft="30dp"
                        android:paddingTop="14dp"
                        android:paddingRight="30dp"
                        android:paddingBottom="28dp">

                        <include
                            layout="@layout/layout_ingredient_status_legend"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="18dp" />

                        <LinearLayout
                            android:id="@+id/inventoryItemsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ImageView
                android:id="@+id/inventoryAddFab"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|bottom"

                android:layout_marginEnd="@dimen/inventory_fab_card_inset"
                android:layout_marginBottom="36dp"
                android:background="@drawable/bg_fab_green"
                android:padding="9dp"
                android:src="@drawable/ic_add" />
        </FrameLayout>

        <include layout="@layout/partial_bottom_nav" />
    </LinearLayout>
</FrameLayout>
