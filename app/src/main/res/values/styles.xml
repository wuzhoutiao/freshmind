<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="IngredientTagBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="IngredientTagRed" parent="IngredientTagBase">
        <item name="android:background">@drawable/bg_tag_red</item>
        <item name="android:textColor">@color/fresh_red</item>
    </style>

    <style name="IngredientTagBlue" parent="IngredientTagBase">
        <item name="android:background">@drawable/bg_tag_blue</item>
        <item name="android:textColor">@color/fresh_blue</item>
    </style>

    <style name="IngredientTagGreen" parent="IngredientTagBase">
        <item name="android:background">@drawable/bg_tag_green</item>
    </style>

    <style name="FreshMindDatePickerTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/fresh_green</item>
        <item name="android:colorControlActivated">@color/fresh_green</item>
        <item name="android:colorControlNormal">@color/fresh_tag_blue</item>
        <item name="android:textColorPrimary">@color/fresh_blue</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>
</resources>
